id robotics solutions for corporate events, product launches, expos, and education.\">\n\n    <title>AURA HUMANOID TECH | Premium Humanoid Robotics</title>\n    <link rel=\"canonical\" href=\"https://aurahumanoidtech.com\">\n\n    <!-- Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link\n        href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;700;800&display=swap\"\n        rel=\"stylesheet\">\n\n    <!-- CSS -->\n    <link rel=\"stylesheet\" href=\"css/style.css\">\n\n    <!-- Schema.org for Local Business / Organization -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Corporation\",\n      \"name\": \"AURA HUMANOID TECH\",\n      \"url\": \"https://aurahumanoidtech.com\",\n      \"logo\": \"https://aurahumanoidtech.com/assets/logo.png\",\n      \"contactPoint\": [\n        {\n          \"@type\": \"ContactPoint\",\n          \"telephone\": \"+60102090179\",\n          \"contactType\": \"customer service\",\n          \"email\": \"info@aurahumanoidtech.com\",\n          \"areaServed\": \"MY\"\n        }\n      ],\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"streetAddress\": \"No. 1, Jalan Anggerik Tainia AW 31/AW\",\n        \"addressLocality\": \"Kota Kemuning, Shah Alam\",\n        \"addressRegion\": \"Selangor\",\n        \"postalCode\": \"40460\",\n        \"addressCountry\": \"MY\"\n      },\n      \"taxID\": \"003884766-K\"\n    }\n    </script>\n</head>\n\n<body>\n    <!-- Header / Navigation -->\n    <header class=\"navbar\" id=\"navbar\">\n        <div class=\"container nav-container\">\n            <div class=\"logo\">\n                <a href=\"#home\">AURA <span>HUMANOID TECH</span></a>\n            </div>\n            <nav class=\"nav-links\">\n                <a href=\"#home\">Home</a>